install_sudo(){
 if id "$SYS_ADMIN_USER" &>/dev/null; then
        echo "User $SYS_ADMIN_USER already exists."
    else
        useradd -m "$SYS_ADMIN_USER"
        echo "$SYS_ADMIN_USER:$SYS_ADMIN_PASS" | chpasswd
        usermod -aG sudo "$SYS_ADMIN_USER"

        sed -i 's/#PermitRootLogin yes/PermitRootLogin no/g' /etc/ssh/sshd_config
        sed -i 's/PermitRootLogin yes/PermitRootLogin no/g' /etc/ssh/sshd_config
        echo "AllowGroups $SYS_ADMIN_USER" >> /etc/ssh/sshd_config
        systemctl restart ssh
    fi
}

