install_firewall_kvm () {
clear
echo "Installing iptables optimized..."

# Enable IP Forwarding at i-disable ang Reverse Path Filter (rp_filter)
echo "net.ipv4.ip_forward=1
net.ipv4.conf.all.rp_filter=0
net.ipv4.conf.${server_interface}.rp_filter=0" >> /etc/sysctl.conf
sysctl -p

{
# Flush existing rules para malinis ang firewall
iptables -F
iptables -t nat -F

# Set FORWARD Policy to ACCEPT
iptables -P FORWARD ACCEPT

# Hysteria UDP Port Forwarding (In-forward sa Hysteria port 5666)
iptables -t nat -A PREROUTING -i "$server_interface" -p udp -m udp --dport 10000:50000 -j DNAT --to-destination :5666

# NAT Routing para sa OpenVPN Subnets (10.10.0.0/16 at 10.20.0.0/16)
iptables -t nat -A POSTROUTING -s 10.10.0.0/16 -o "$server_interface" -j MASQUERADE
iptables -t nat -A POSTROUTING -s 10.20.0.0/16 -o "$server_interface" -j MASQUERADE

# Save persistent rules sa tamang directory
mkdir -p /etc/iptables
echo iptables-persistent iptables-persistent/autosave_v4 boolean true | sudo debconf-set-selections
echo iptables-persistent iptables-persistent/autosave_v6 boolean true | sudo debconf-set-selections
sudo apt -y install iptables-persistent
iptables-save > /etc/iptables/rules.v4
ip6tables-save > /etc/iptables/rules.v6

# Optimization para sa File Descriptors (Limits)
sed -i '/^\*\ *soft\ *nofile\ *[[:digit:]]*/d' /etc/security/limits.conf
sed -i '/^\*\ *hard\ *nofile\ *[[:digit:]]*/d' /etc/security/limits.conf
echo '* soft nofile 65536' >>/etc/security/limits.conf
echo '* hard nofile 65536' >>/etc/security/limits.conf
}&>/dev/null
}

