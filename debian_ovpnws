setup_goproxy () {
    cat << 'EOF' > /tmp/main.go
package main

import (
	"bufio"
	"flag"
	"fmt"
	"io"
	"net"
	"os"
	"os/signal"
	"strconv"
	"strings"
	"syscall"
	"time"
)

var (
	listeningAddr = "0.0.0.0"
	listeningPort = 80
	pass          = ""
	defaultHost   = "127.0.0.1:1194"
	bufSize       = 65536
	timeout       = 300 * time.Second
	response      = []byte("HTTP/1.1 101 Dexter Eskalarte \r\n\r\n")
)

func main() {
	flag.StringVar(&listeningAddr, "b", listeningAddr, "Bind Address")
	flag.IntVar(&listeningPort, "p", listeningPort, "Listening Port")
	flag.Parse()

	if flag.NArg() > 0 {
		if p, err := strconv.Atoi(flag.Arg(0)); err == nil {
			listeningPort = p
		}
	}

	bindAddr := fmt.Sprintf("%s:%d", listeningAddr, listeningPort)
	listener, err := net.Listen("tcp", bindAddr)
	if err != nil {
		fmt.Printf("Error starting server: %v\n", err)
		os.Exit(1)
	}
	defer listener.Close()

	fmt.Println("\n:-------GoProxy-------:")
	fmt.Printf("Listening addr: %s\n", listeningAddr)
	fmt.Printf("Listening port: %d\n\n", listeningPort)
	fmt.Println(":---------------------:\n")

	sigChan := make(chan os.Signal, 1)
	signal.Notify(sigChan, os.Interrupt, syscall.SIGTERM)
	go func() {
		<-sigChan
		fmt.Println("\nStopping server...")
		listener.Close()
		os.Exit(0)
	}()

	for {
		clientConn, err := listener.Accept()
		if err != nil {
			break
		}

		if tcpConn, ok := clientConn.(*net.TCPConn); ok {
			tcpConn.SetKeepAlive(true)
			tcpConn.SetKeepAlivePeriod(3 * time.Minute)
		}

		go handleConnection(clientConn)
	}
}

func handleConnection(client net.Conn) {
	defer client.Close()

	buffer := make([]byte, bufSize)
	client.SetReadDeadline(time.Now().Add(10 * time.Second))
	n, err := client.Read(buffer)
	if err != nil || n == 0 {
		return
	}
	client.SetReadDeadline(time.Time{})

	headerText := string(buffer[:n])

	hostPort := findHeader(headerText, "X-Real-Host")
	if hostPort == "" {
		hostPort = defaultHost
	}

	split := findHeader(headerText, "X-Split")
	if split != "" {
		client.SetReadDeadline(time.Now().Add(2 * time.Second))
		dummyBuf := make([]byte, bufSize)
		client.Read(dummyBuf)
		client.SetReadDeadline(time.Time{})
	}

	passwd := findHeader(headerText, "X-Pass")
	if len(pass) != 0 && passwd == pass {
		methodConnect(client, hostPort)
	} else if len(pass) != 0 && passwd != pass {
		client.Write([]byte("HTTP/1.1 400 WrongPass!\r\n\r\n"))
	} else if strings.HasPrefix(hostPort, "127.0.0.1") || strings.HasPrefix(hostPort, "localhost") {
		methodConnect(client, hostPort)
	} else {
		client.Write([]byte("HTTP/1.1 403 Forbidden!\r\n\r\n"))
	}
}

func findHeader(head, headerName string) string {
	scanner := bufio.NewScanner(strings.NewReader(head))
	target := strings.ToLower(headerName + ":")

	for scanner.Scan() {
		line := scanner.Text()
		if strings.HasPrefix(strings.ToLower(line), target) {
			parts := strings.SplitN(line, ":", 2)
			if len(parts) == 2 {
				return strings.TrimSpace(parts[1])
			}
		}
	}
	return ""
}

func methodConnect(client net.Conn, targetHost string) {
	if !strings.Contains(targetHost, ":") {
		targetHost = fmt.Sprintf("%s:443", targetHost)
	}

	targetConn, err := net.DialTimeout("tcp", targetHost, 10*time.Second)
	if err != nil {
		fmt.Printf("Connection: %s - Error connecting to target %s: %v\n", client.RemoteAddr(), targetHost, err)
		return
	}
	defer targetConn.Close()

	if tcpConn, ok := targetConn.(*net.TCPConn); ok {
		tcpConn.SetKeepAlive(true)
		tcpConn.SetKeepAlivePeriod(3 * time.Minute)
	}

	_, err = client.Write(response)
	if err != nil {
		return
	}

	fmt.Printf("Connection: %s - CONNECT %s\n", client.RemoteAddr(), targetHost)

	doProxy(client, targetConn)
}

func doProxy(client, target net.Conn) {
	errChan := make(chan error, 2)

	go func() {
		_, err := io.Copy(target, client)
		errChan <- err
	}()

	go func() {
		_, err := io.Copy(client, target)
		errChan <- err
	}()

	select {
	case <-errChan:
		return
	case <-time.After(timeout):
		return
	}
}
EOF
    dos2unix /tmp/main.go
    go build -o /usr/bin/goproxy /tmp/main.go
    chmod +x /usr/bin/goproxy
    rm -f /tmp/main.go
    fuser -k 80/tcp 2>/dev/null
    killall -9 python3 goproxy 2>/dev/null

    cat << 'EOF' > /etc/systemd/system/goproxy.service
[Unit]
Description=GoProxy Service
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/goproxy -b 0.0.0.0 -p 80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable goproxy
    systemctl restart goproxy
}

